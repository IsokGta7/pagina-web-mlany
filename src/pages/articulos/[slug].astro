---
import ArticuloLayout from '../../layouts/ArticuloLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articulos = (await getCollection('articulos')).filter((a) => !a.data.draft);
  return articulos.map((articulo) => ({
    params: { slug: articulo.id },
    props: { articulo },
  }));
}

const { articulo } = Astro.props;
const { Content } = await render(articulo);
---

<ArticuloLayout
  title={articulo.data.title}
  description={articulo.data.description}
  date={articulo.data.date}
  category={articulo.data.category}
  coverImage={articulo.data.coverImage}
  author={articulo.data.author}
  authorRef={articulo.data.authorRef}
  slug={articulo.id}
  seoTitle={articulo.data.seoTitle}
  seoDescription={articulo.data.seoDescription}
  seoOgImage={articulo.data.seoOgImage}
  relatedArticles={articulo.data.relatedArticles}
  tags={articulo.data.tags}
>
  <Content />
</ArticuloLayout>
