---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  lastUpdated: Date;
}

const { title, lastUpdated } = Astro.props;

const formattedDate = new Date(lastUpdated).toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title}>
  <Header />
  <main class="flex-1">
    <article class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
      <header class="mb-8">
        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-navy dark:text-warm-white mb-2">
          {title}
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Última actualización: <time datetime={new Date(lastUpdated).toISOString()}>{formattedDate}</time>
        </p>
      </header>
      <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-serif prose-a:text-teal">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
