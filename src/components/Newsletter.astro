---
import settings from '../data/settings.json';

const nl = settings.newsletter || {};
const enabled = nl.enabled === true && nl.actionUrl;
const title = nl.title || 'Suscríbete';
const subtitle = nl.subtitle || 'Recibe nuestros artículos directamente en tu correo.';
const emailPlaceholder = nl.emailPlaceholder || 'tu@correo.com';
const submitLabel = nl.submitLabel || 'Suscribirme';
const successMessage = nl.successMessage || '¡Gracias por suscribirte!';
---

{enabled && (
  <section class="max-w-3xl mx-auto px-4 py-12 fade-in">
    <div class="bg-gray-100 dark:bg-navy-light rounded-2xl p-8 text-center">
      <h2 class="font-serif text-2xl font-bold text-navy dark:text-warm-white mb-2">{title}</h2>
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-6 max-w-md mx-auto">{subtitle}</p>
      <form class="newsletter-form flex flex-col sm:flex-row gap-3 max-w-md mx-auto" action={nl.actionUrl} method="post" target="_blank">
        <label class="sr-only" for="newsletter-email">Correo electrónico</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder={emailPlaceholder}
          class="flex-1 px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-navy text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-teal/50 focus:border-teal transition-colors"
        />
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-teal text-navy font-semibold hover:bg-teal-dark transition-colors">
          {submitLabel}
        </button>
      </form>
      <p class="newsletter-success hidden mt-4 text-sm text-teal">{successMessage}</p>
    </div>
  </section>
)}
