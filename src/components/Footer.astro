---
import settings from '../data/settings.json';
import misc from '../data/content/misc.json';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';
import Img from './Img.astro';

const year = new Date().getFullYear();
const siteName = settings.siteName || 'Ciensite';
const social = settings.social || {};
const hasSocialLinks = social.instagram || social.youtube || social.tiktok;
const f = misc.footer;
---

<footer class="bg-gray-100 text-gray-700 dark:bg-navy dark:text-gray-300">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Marca -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-4" aria-label={`${siteName} — Inicio`}>
          {settings.logo ? (
            <Img src={settings.logo} alt={siteName} class="h-7 w-auto" sizes="200px" />
          ) : (
            <>
              <Logo class="w-7 h-7 text-teal" />
              <span class="font-serif text-lg font-bold text-navy dark:text-warm-white">{siteName}</span>
            </>
          )}
        </a>
        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
          {f.tagline}
        </p>
      </div>

      <!-- Navegación -->
      <nav aria-label="Navegación del pie de página">
        <h3 class="font-semibold text-navy dark:text-warm-white mb-3 text-sm uppercase tracking-wider">{f.exploreHeading}</h3>
        <ul class="space-y-2">
          <li><a href="/articulos/" class="text-sm hover:text-teal transition-colors">Artículos</a></li>
          <li><a href="/multimedia/" class="text-sm hover:text-teal transition-colors">Multimedia</a></li>
          <li><a href="/equipo/" class="text-sm hover:text-teal transition-colors">Equipo</a></li>
          <li><a href="/contacto/" class="text-sm hover:text-teal transition-colors">Contacto</a></li>
          <li><a href="/privacidad/" class="text-sm hover:text-teal transition-colors">Privacidad</a></li>
          <li><a href="/terminos/" class="text-sm hover:text-teal transition-colors">Términos</a></li>
        </ul>
      </nav>

      <!-- Redes sociales -->
      {hasSocialLinks && (
        <div>
          <h3 class="font-semibold text-navy dark:text-warm-white mb-3 text-sm uppercase tracking-wider">{f.followHeading}</h3>
          <div class="flex gap-3">
            {(['instagram', 'youtube', 'tiktok'] as const).map((p) => social[p] && (
              <a href={social[p]} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-white dark:bg-navy-light hover:bg-teal/20 transition-colors" aria-label={p.charAt(0).toUpperCase() + p.slice(1)}>
                <SocialIcon platform={p} />
              </a>
            ))}
            <a href="/rss.xml" class="p-2 rounded-lg bg-white dark:bg-navy-light hover:bg-teal/20 transition-colors" aria-label="Feed RSS">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.18 15.64a2.18 2.18 0 012.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 012.18-2.18M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"/>
              </svg>
            </a>
          </div>
        </div>
      )}
    </div>

    <!-- Créditos -->
    <div class="pt-8 border-t border-gray-300/50 dark:border-gray-700/50 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        &copy; {year} {siteName}. {f.copyrightSuffix}
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-400 flex items-center gap-3">
        <a href="/admin/" class="inline-flex items-center gap-1.5 text-gray-600 dark:text-gray-300 hover:text-teal transition-colors" aria-label="Administrar contenido del sitio">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          {f.adminLabel}
        </a>
        <span class="text-gray-400 dark:text-gray-600">·</span>
        <span>Desarrollado por <a href="https://github.com/IsokGta7" target="_blank" rel="noopener noreferrer" class="text-teal hover:underline">Isaac Rodríguez</a></span>
      </p>
    </div>
  </div>
</footer>
