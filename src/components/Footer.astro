---
import settings from '../data/settings.json';
import misc from '../data/content/misc.json';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();
const siteName = settings.siteName || 'Ciensite';
const social = settings.social || {};
const hasSocialLinks = social.instagram || social.youtube || social.tiktok;
const f = misc.footer;
---

<footer class="bg-navy text-gray-300">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Marca -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-4" aria-label={`${siteName} — Inicio`}>
          {settings.logo ? (
            <img src={settings.logo} alt={siteName} class="h-7 w-auto" />
          ) : (
            <>
              <Logo class="w-7 h-7 text-teal" />
              <span class="font-serif text-lg font-bold text-warm-white">{siteName}</span>
            </>
          )}
        </a>
        <p class="text-sm text-gray-400 leading-relaxed">
          {f.tagline}
        </p>
      </div>

      <!-- Navegación -->
      <nav aria-label="Navegación del pie de página">
        <h3 class="font-semibold text-warm-white mb-3 text-sm uppercase tracking-wider">{f.exploreHeading}</h3>
        <ul class="space-y-2">
          <li><a href="/articulos/" class="text-sm hover:text-teal transition-colors">Artículos</a></li>
          <li><a href="/multimedia/" class="text-sm hover:text-teal transition-colors">Multimedia</a></li>
          <li><a href="/equipo/" class="text-sm hover:text-teal transition-colors">Equipo</a></li>
          <li><a href="/contacto/" class="text-sm hover:text-teal transition-colors">Contacto</a></li>
        </ul>
      </nav>

      <!-- Redes sociales -->
      {hasSocialLinks && (
        <div>
          <h3 class="font-semibold text-warm-white mb-3 text-sm uppercase tracking-wider">{f.followHeading}</h3>
          <div class="flex gap-3">
            {(['instagram', 'youtube', 'tiktok'] as const).map((p) => social[p] && (
              <a href={social[p]} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-navy-light hover:bg-teal/20 transition-colors" aria-label={p.charAt(0).toUpperCase() + p.slice(1)}>
                <SocialIcon platform={p} />
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Créditos -->
    <div class="pt-8 border-t border-gray-700/50 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-gray-400">
        &copy; {year} {siteName}. {f.copyrightSuffix}
      </p>
    </div>
  </div>
</footer>
