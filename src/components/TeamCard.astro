---
import SocialIcon from './SocialIcon.astro';
import Img from './Img.astro';

interface Props {
  name: string;
  role: string;
  bio: string;
  photo: string;
  socialLinks?: {
    instagram?: string;
    twitter?: string;
    linkedin?: string;
  };
}

const { name, role, bio, photo, socialLinks } = Astro.props;

const teamPlatforms = [
  { key: 'instagram', label: 'Instagram' },
  { key: 'twitter', label: 'Twitter' },
  { key: 'linkedin', label: 'LinkedIn' },
] as const;
---

<article class="text-center p-6 bg-white dark:bg-navy-light rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300">
  <Img
    src={photo}
    alt={`Foto de ${name}`}
    class="w-28 h-28 rounded-full mx-auto mb-4 object-cover ring-4 ring-teal/20"
    sizes="112px"
  />
  <h3 class="font-serif text-lg font-bold text-navy dark:text-warm-white mb-1">{name}</h3>
  <p class="text-sm text-teal font-medium mb-3">{role}</p>
  <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-4">{bio}</p>

  {socialLinks && (
    <div class="flex justify-center gap-3">
      {teamPlatforms.map(({ key, label }) => socialLinks[key] && (
        <a href={socialLinks[key]} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-teal transition-colors" aria-label={`${label} de ${name}`}>
          <SocialIcon platform={key} />
        </a>
      ))}
    </div>
  )}
</article>
