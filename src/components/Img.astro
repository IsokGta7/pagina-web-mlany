---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { imageMetadata } from 'astro/assets/utils';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  sizes?: string;
  quality?: number;
}

const {
  src,
  alt,
  width,
  height,
  class: className,
  loading = 'lazy',
  priority = false,
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px',
  quality = 80,
} = Astro.props;

const isDev = import.meta.env.DEV;
const isExternal = /^(https?:)?\/\//.test(src) || src.startsWith('data:');
const useOptimization = !isDev && !isExternal && src.length > 0;

function cdn(url: string, w: number): string {
  const params = new URLSearchParams({
    url,
    w: String(w),
    fm: 'webp',
    q: String(quality),
  });
  return `/.netlify/images?${params.toString()}`;
}

const widths = [400, 800, 1200, 1600];
const srcset = useOptimization
  ? widths.map((w) => `${cdn(src, w)} ${w}w`).join(', ')
  : undefined;

const finalSrc = useOptimization ? cdn(src, 1200) : src;

// Files under public/ (CMS uploads) have dimensions we can read at build time. Passing them lets
// the browser reserve the image's space before it loads; the CSS classes still decide the size.
async function localDimensions(url: string): Promise<{ width?: number; height?: number }> {
  if (isExternal || !url.startsWith('/')) return {};
  try {
    const file = path.join(process.cwd(), 'public', decodeURI(url.split(/[?#]/)[0]));
    const { width, height } = await imageMetadata(await readFile(file), url);
    return { width, height };
  } catch {
    return {};
  }
}

const dimensions = width === undefined && height === undefined ? await localDimensions(src) : { width, height };
---

<img
  src={finalSrc}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={dimensions.width}
  height={dimensions.height}
  class={className}
  loading={priority ? 'eager' : loading}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
/>
