/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://identity.netlify.com https://unpkg.com https://giscus.app https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://*.githubusercontent.com https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self' https://fonts.gstatic.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.instagram.com https://www.google.com https://maps.google.com https://giscus.app; connect-src 'self' https://identity.netlify.com https://api.github.com https://*.netlify.com https://www.google-analytics.com https://*.analytics.google.com https://*.google-analytics.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.list-manage.com https://buttondown.email https://*.buttondown.email https://substack.com https://*.substack.com https://app.convertkit.com https://*.ck.page https://app.mailerlite.com https://*.mailerlite.com https://*.beehiiv.com; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/.netlify/images/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=3600

/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://identity.netlify.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://*.githubusercontent.com https://*.netlify.com; font-src 'self' data: https://unpkg.com; connect-src 'self' blob: data: https://api.github.com https://*.netlify.com https://identity.netlify.com https://unpkg.com; frame-src 'none'; frame-ancestors 'self'
  X-Frame-Options: DENY
  Cache-Control: no-store, no-cache, must-revalidate
